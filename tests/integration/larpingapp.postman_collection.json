					"event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [ "// downloadPdf is #[NoAdminRequired] (a logged-in session is still required);", "// an anonymous request is rejected by NC SecurityMiddleware with 401.", "pm.test('anonymous rejected 401', () => pm.response.to.have.status(401));" ] } } ],
					"request": { "method": "GET", "header": [ { "key": "Accept", "value": "application/json" } ], "url": { "raw": "{{noAuthBase}}/index.php/apps/larpingapp/characters/{{charId}}/download/00000000-0000-4000-8000-000000000000", "host": [ "{{noAuthBase}}" ], "path": [ "index.php", "apps", "larpingapp", "characters", "{{charId}}", "download", "00000000-0000-4000-8000-000000000000" ] } }
				}
