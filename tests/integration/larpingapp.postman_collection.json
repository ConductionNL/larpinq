		{
			"name": "3. Character PDF compute endpoint",
			"item": [
				{
					"name": "downloadPdf ERROR: invalid (non-UUID) template -> 400 not 500",
					"event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [ "// Authenticated admin, but a non-UUID template id is rejected with 400 by", "// the controller's UUID guard (path-traversal/injection defence, #218) —", "// before DocuDesk is touched. Must not 500.", "pm.test('invalid template rejected 400', () => pm.response.to.have.status(400));", "pm.test('not a 500', () => pm.expect(pm.response.code).to.not.eql(500));" ] } } ],
					"request": { "auth": { "type": "basic", "basic": [ { "key": "username", "value": "{{adminUser}}", "type": "string" }, { "key": "password", "value": "{{adminPass}}", "type": "string" } ] }, "method": "GET", "header": [ { "key": "OCS-APIRequest", "value": "true" }, { "key": "Accept", "value": "application/json" } ], "url": { "raw": "{{baseUrl}}/index.php/apps/larpingapp/characters/{{charId}}/download/not-a-uuid", "host": [ "{{baseUrl}}" ], "path": [ "index.php", "apps", "larpingapp", "characters", "{{charId}}", "download", "not-a-uuid" ] } }
				},
				{
					"name": "downloadPdf ERROR: valid-UUID template but DocuDesk template not found -> 4xx not 500",
					"event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [ "// A syntactically-valid UUID that does not resolve to a real template.", "// Depending on DocuDesk presence this is 404 (template not found) or 424", "// (DocuDesk not installed). Either way it must be a clean 4xx, never 500.", "pm.test('clean 4xx, not 500', () => { pm.expect(pm.response.code).to.be.within(400, 499); pm.expect(pm.response.code).to.not.eql(500); });" ] } } ],
					"request": { "auth": { "type": "basic", "basic": [ { "key": "username", "value": "{{adminUser}}", "type": "string" }, { "key": "password", "value": "{{adminPass}}", "type": "string" } ] }, "method": "GET", "header": [ { "key": "OCS-APIRequest", "value": "true" }, { "key": "Accept", "value": "application/json" } ], "url": { "raw": "{{baseUrl}}/index.php/apps/larpingapp/characters/{{charId}}/download/00000000-0000-4000-8000-000000000000", "host": [ "{{baseUrl}}" ], "path": [ "index.php", "apps", "larpingapp", "characters", "{{charId}}", "download", "00000000-0000-4000-8000-000000000000" ] } }
				},
