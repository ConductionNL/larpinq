# Larpinq — Conduction PHPStan config.
#
# The shared base is the single source of truth. Everything here is either the
# app's own tracked debt or an ignore naming a symbol that exists in no other
# fleet app. Anything you are tempted to add that another app would also need
# belongs in the base, not here.
includes:
    - vendor/conduction/hydra-gates/quality-config/phpstan-base.neon
    # Per-app tracked lint debt (auto-generated via `phpstan --generate-baseline`).
    - phpstan-baseline.neon

parameters:
    # App-specific only. The base already sets level, paths, bootstrapFiles,
    # excludePaths, scanDirectories and every fleet-wide ignore.
    ignoreErrors:
        # PHPDoc-driven type widening: getObjects() is typed array<int, array<string,mixed>>
        # so is_array() guards are always true from PHPStan's perspective but are kept as
        # runtime defence against mixed returns from dynamic mappers.
        - '#Strict comparison using === between true and false will always evaluate to false#'
        # OCP\AppFramework\Http\DataResponse uses a @template-covariant T of DataResponseType
        # where DataResponseType is `array|int|float|string|bool|object|null|\stdClass|\JsonSerializable`.
        # PHPStan incorrectly rejects narrowly-typed arrays (e.g. array<string, true>) as
        # non-matching template arguments even though array IS in DataResponseType.
        # This is a known stub false-positive; the arrays passed are all valid response shapes.
        - '#Parameter \#1 \$data of class OCP\\AppFramework\\Http\\DataResponse constructor expects T of OCP\\AppFramework\\Http\\DataResponseType#'
