# Tempo Import - API Configuration Template
# 
# INSTRUCTIONS:
# 1. Copy this file to: tempo_config.env
# 2. Fill in your actual values below
# 3. DO NOT commit tempo_config.env to git!
#

# =============================================================================
# JIRA CONFIGURATION
# =============================================================================

# Jira API Token
# How to get: https://id.atlassian.com/manage-profile/security/api-tokens
# Click "Create API token", copy the token
JIRA_API_TOKEN=your-jira-token-here

# Your Jira URL
# Example: https://conduction.atlassian.net
# Example: https://your-company.atlassian.net
JIRA_URL=https://your-company.atlassian.net

# Your Jira account email
# This must match your Atlassian account email
JIRA_EMAIL=ruben@conduction.nl

# =============================================================================
# TEMPO CONFIGURATION
# =============================================================================

# Tempo API Token
# How to get: Jira → Tempo → Settings → API Integration → New Token
TEMPO_API_TOKEN=your-tempo-token-here

# Email for Tempo account
# IMPORTANT: This ensures time is logged only for YOUR account
# Usually same as JIRA_EMAIL
TEMPO_EMAIL=ruben@conduction.nl

# =============================================================================
# USER CONFIGURATION
# =============================================================================

# GitHub user name (as it appears in git commits)
# Used to filter commits
GITHUB_USER=Ruben van der Linde

# =============================================================================
# OPTIONAL SETTINGS
# =============================================================================

# Grouping mode: daily or weekly
# daily = one issue per day (more detail)
# weekly = one issue per week (less issues)
GROUPING=daily

# Include overtime entries?
# Set to 1 to include, 0 to skip
INCLUDE_OVERTIME=1







