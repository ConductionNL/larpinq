            "items": {
              "type": "string",
              "format": "uuid"
            },
            "$ref": "ability",
            "x-relation-filter": { "setting": "@object.setting" },
            "visible": false,
            "title": "Required Stats"
          },
          "requiredConditions": {
            "type": "array",
            "description": "Required conditions",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "$ref": "condition",
            "x-relation-filter": { "setting": "@object.setting" },
            "visible": false,
            "title": "Required Conditions"
          },
          "requiredEffects": {
            "type": "array",
            "description": "Required effects",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "$ref": "effect",
            "x-relation-filter": { "setting": "@object.setting" },
            "visible": false,
            "title": "Required Effects"
          },
          "requiredScore": {
            "type": "integer",
            "description": "Minimum ability score needed when requirements are abilities",
            "visible": false,
            "title": "Required Score"
          },
          "setting": {
            "type": "string",
            "format": "uuid",
            "$ref": "setting",
            "description": "Optional setting (world/campaign) this skill belongs to. Empty means shared across all settings.",
            "visible": false,
            "title": "Setting"
          }
        }
