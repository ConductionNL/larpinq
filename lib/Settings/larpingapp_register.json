{
  "openapi": "3.0.0",
  "info": {
    "title": "LarpingApp Register",
    "description": "Live Action Role Playing character management register for the LarpingApp Nextcloud app. Manages characters, players, abilities, skills, items, conditions, effects, events, and settings.",
    "version": "1.2.0"
  },
  "x-openregister": {
    "type": "application",
    "app": "larpingapp",
    "openregister": "^v0.2.10",
    "description": "LARP character management data model — thin client on OpenRegister, no own database tables"
  },
  "components": {
    "registers": {
      "larpingapp": {
        "slug": "larpingapp",
        "title": "LarpingApp",
        "version": "1.0.0",
        "description": "Live Action Role Playing character management register — manages characters, players, abilities, skills, items, conditions, effects, events, and game settings.",
        "published": "2026-03-01T00:00:00+00:00",
        "schemas": [
          "character",
          "player",
          "ability",
          "skill",
          "larping_item",
          "condition",
          "effect",
          "larping_event",
          "setting",
          "xpAward"
        ],
        "tablePrefix": "",
        "folder": "Open Registers/LarpingApp"
      }
    },
    "schemas": {
      "character": {
        "slug": "character",
        "title": "Character",
        "icon": "BriefcaseAccountOutline",
        "version": "1.4.0",
        "summary": "A playable or non-playable character in the LARP game",
        "description": "Represents a character entity with stats, skills, items, conditions, and event participation. Characters can be player characters, NPCs, or other types. Game masters approve characters before play.",
        "type": "object",
        "x-schema-org": "schema:Person",
        "required": [
          "name",
          "ocName"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "The chosen in-game name for this character",
            "maxLength": 255,
            "minLength": 1,
            "title": "Character Name"
          },
          "ocName": {
            "type": "string",
            "format": "uuid",
            "$ref": "player",
            "x-allow-create": true,
            "description": "The player who plays this character. Pick an existing player or type a new name to create one.",
            "title": "Player"
          },
          "ownerUid": {
            "type": "string",
            "description": "Auto-derived Nextcloud uid of the owning player's user account (materialised from the linked player). Not user-editable.",
            "maxLength": 255,
            "title": "Owner UID",
            "visible": false,
            "readOnly": true
          },
          "description": {
            "type": "string",
            "description": "Public description visible to all players",
            "maxLength": 2555,
            "title": "Description"
          },
          "background": {
            "type": "string",
            "description": "Character background story (visible to GMs only)",
            "maxLength": 2555,
            "visible": false,
            "title": "Background Story"
          },
          "type": {
            "type": "string",
            "description": "Character type classification",
            "enum": [
              "player",
              "npc",
              "other"
            ],
            "default": "player",
            "title": "Type",
            "facetable": true
          },
          "approved": {
            "type": "string",
            "description": "Approval status by game master",
            "enum": [
              "no",
              "approved"
            ],
            "default": "no",
            "widget": "switch",
            "title": "Approved",
            "facetable": true
          },
          "gold": {
            "type": "integer",
            "description": "Amount of gold pieces",
            "default": 0,
            "visible": false,
            "title": "Gold Pieces"
          },
          "silver": {
            "type": "integer",
            "description": "Amount of silver pieces",
            "default": 0,
            "visible": false,
            "title": "Silver Pieces"
          },
          "copper": {
            "type": "integer",
            "description": "Amount of copper pieces",
            "default": 0,
            "visible": false,
            "title": "Copper Pieces"
          },
          "faith": {
            "type": "string",
            "description": "The faith or religion of the character",
            "maxLength": 2555,
            "visible": false,
            "title": "Faith"
          },
          "slNotesPublic": {
            "type": "string",
            "description": "Game master notes visible to players",
            "maxLength": 2555,
            "visible": false,
            "title": "Game Master Notes (Public)"
          },
          "slNotesPrivate": {
            "type": "string",
            "description": "Game master notes NOT visible to players",
            "maxLength": 2555,
            "visible": false,
            "title": "Game Master Notes (Private)"
          },
          "card": {
            "type": "string",
            "description": "Character card as markdown table",
            "maxLength": 5000,
            "visible": false,
            "title": "Character Card"
          },
          "itemsAndMoney": {
            "type": "string",
            "description": "Notes about items and money",
            "maxLength": 2555,
            "visible": false,
            "title": "Items and Money"
          },
          "notice": {
            "type": "string",
            "description": "Automatic system notices",
            "maxLength": 2555,
            "visible": false,
            "title": "System Notice"
          },
          "skills": {
            "type": "array",
            "description": "Skills this character possesses",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "$ref": "skill",
            "x-relation-filter": { "setting": "@object.setting" },
            "visible": false,
            "title": "Skills"
          },
          "items": {
            "type": "array",
            "description": "Items this character owns",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "$ref": "larping_item",
            "x-relation-filter": { "setting": "@object.setting" },
            "visible": false,
            "title": "Items"
          },
          "conditions": {
            "type": "array",
            "description": "Conditions currently affecting this character",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "$ref": "condition",
            "x-relation-filter": { "setting": "@object.setting" },
            "visible": false,
            "title": "Conditions"
          },
          "events": {
            "type": "array",
            "description": "Events this character is subscribed to",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "$ref": "larping_event",
            "x-relation-filter": { "setting": "@object.setting" },
            "visible": false,
            "title": "Events"
          },
          "setting": {
            "type": "string",
            "format": "uuid",
            "$ref": "setting",
            "description": "Optional setting (world/campaign) this character belongs to. Empty means shared across all settings.",
            "visible": false,
            "title": "Setting"
          },
          "requirementOverrides": {
            "type": "array",
            "description": "Explicit, audited GM overrides of unmet skill requirements. Each entry waives requirement enforcement for one skill assignment, recording who overrode it and why. Writing this field is restricted to game masters server-side.",
            "items": {
              "type": "object",
              "properties": {
                "skill": {
                  "type": "string",
                  "format": "uuid",
                  "$ref": "skill",
                  "x-relation-filter": { "setting": "@object.setting" },
                  "description": "The assigned skill whose requirements are waived",
                  "title": "Skill"
                },
                "reason": {
                  "type": "string",
                  "description": "Mandatory reason for the override (audited)",
                  "title": "Override Reason"
                },
                "overriddenBy": {
                  "type": "string",
                  "description": "Nextcloud uid of the GM who authored the override (server-stamped)",
                  "title": "Overridden By"
                },
                "overriddenAt": {
                  "type": "string",
                  "format": "date-time",
                  "description": "When the override was authored (server-stamped)",
                  "title": "Overridden At"
                }
              }
            },
            "visible": false,
            "title": "Requirement Overrides"
          }
        },
        "x-openregister-references": {
          "player": {
            "schema": "player",
            "mode": "relatedObject",
            "field": "ocName"
          }
        },
        "x-openregister-calculations": {
          "ownerUid": {
            "type": "string",
            "materialise": true,
            "expression": {
              "prop": "@ref.player.userUid"
            }
          }
        },
        "configuration": {
          "linkedTypes": [
            "photos"
          ],
          "x-openregister-lifecycle": {
            "field": "approved",
            "initial": "no",
            "final": [
              "approved"
            ],
            "transitions": {
              "approved": {
                "from": [
                  "no"
                ],
                "to": "approved",
                "description": "Game master approves the character for play."
              },
              "unapprove": {
                "from": [
                  "approved"
                ],
                "to": "no",
                "description": "Revoke approval (e.g. character changed substantially)."
              }
            }
          }
        },
        "x-openregister-notifications": {
          "character-submitted": {
            "trigger": {
              "type": "created"
            },
            "enabled": true,
            "channels": [
              "nc-notification"
            ],
            "recipients": [
              {
                "kind": "groups",
                "groups": [
                  "gamemasters"
                ]
              }
            ],
            "subject": {
              "nl": "Nieuw personage ingediend: {{name}}",
              "en": "New character submitted: {{name}}"
            }
          },
          "character-approved": {
            "trigger": {
              "type": "transition",
              "action": "approved"
            },
            "enabled": true,
            "channels": [
              "nc-notification"
            ],
            "recipients": [
              {
                "kind": "field",
                "field": "ownerUid"
              }
            ],
            "subject": {
              "nl": "Personage {{name}} is goedgekeurd",
              "en": "Character {{name}} has been approved"
            }
          }
        }
      },
      "player": {
        "slug": "player",
        "title": "Player",
        "icon": "AccountGroupOutline",
        "version": "1.1.1",
        "summary": "A real-world player participating in the LARP",
        "description": "Represents a player who controls one or more characters. Tracks player identity and contact information.",
        "type": "object",
        "x-schema-org": "schema:Person",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Full name of the player",
            "maxLength": 255,
            "minLength": 1,
            "title": "Player Name"
          },
          "description": {
            "type": "string",
            "description": "Notes about the player",
            "maxLength": 2555,
            "title": "Description"
          },
          "userUid": {
            "type": "string",
            "description": "The Nextcloud user account this player signs in as (a Nextcloud user UID — a plain string; there is deliberately no `format`, OpenRegister has no `user` format and rejects the whole schema when it sees one). Used for character-ownership notifications.",
            "maxLength": 255,
            "title": "Nextcloud user"
          }
        }
      },
      "ability": {
        "slug": "ability",
        "title": "Ability",
        "icon": "ShieldSwordOutline",
        "version": "1.1.0",
        "summary": "A numeric stat tracked on characters (e.g., XP, Mana, Health)",
        "description": "Represents a numeric ability or stat that characters track. Effects modify abilities by adding or subtracting from the base value. Used for experience points, mana, health, armor, and other quantifiable attributes.",
        "type": "object",
        "x-schema-org": "schema:PropertyValue",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Unique name of the ability (e.g., Experience Points, Mana)",
            "maxLength": 255,
            "minLength": 1,
            "title": "Ability Name"
          },
          "description": {
            "type": "string",
            "description": "What this ability represents within the game setting",
            "maxLength": 2555,
            "title": "Description"
          },
          "base": {
            "type": "integer",
            "description": "Starting value for all characters",
            "default": 0,
            "title": "Base Value"
          },
          "setting": {
            "type": "string",
            "format": "uuid",
            "$ref": "setting",
            "description": "Optional setting (world/campaign) this ability belongs to. Empty means shared across all settings.",
            "visible": false,
            "title": "Setting"
          }
        }
      },
      "skill": {
        "slug": "skill",
        "title": "Skill",
        "icon": "SwordCross",
        "version": "1.1.0",
        "summary": "A learnable ability that characters can acquire",
        "description": "Represents a skill that characters can learn, usually purchased with experience points. Skills provide effects and may have prerequisites (other skills, stats, conditions, or effects).",
        "type": "object",
        "x-schema-org": "schema:DefinedTerm",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Name of the skill (e.g., Healing LvL 1)",
            "maxLength": 255,
            "minLength": 1,
            "title": "Skill Name"
          },
          "description": {
            "type": "string",
            "description": "In-game flavor description of the skill",
            "maxLength": 2555,
            "title": "Description"
          },
          "effect": {
            "type": "string",
