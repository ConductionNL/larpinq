{
	"$schema": "https://codeberg.org/Conduction/nextcloud-vue/raw/branch/main/src/schemas/app-manifest-v2.schema.json",
	"version": "0.3.0",
	"dependencies": ["openregister"],
	"setup": {
		"enabled": true,
		"version": 1,
		"completionConfigKey": "setup_completed_version",
		"steps": [
			{ "id": "welcome", "type": "info", "title": "Welcome to LARPing", "body": "Manage your live-action roleplay world — characters, players, items and events — all in one place. One quick step provisions your data store, then you're ready to play." },
			{ "id": "provision", "type": "run-action", "title": "Provision your world", "required": true, "action": "provision", "body": "Create the LarpingApp register and schemas in OpenRegister — the data store for characters, players, abilities, skills, items, conditions, effects, events and settings. This normally runs automatically on install; run it here if OpenRegister was enabled after LarpingApp, or to repair a partial install. It is safe to run more than once." },
			{ "id": "done", "type": "summary", "title": "You're ready", "healthCheck": true, "body": "That's it — your world's data store is provisioned. Jump into the Dashboard to see it at a glance, and reopen this setup or the guided tour anytime from the app's … menu." }
		]
	},
	"walkthrough": {
		"enabled": true,
		"version": 1,
		"completionConfigKey": "walkthrough_completed_version",
		"tours": [
			{
				"id": "larpingapp:getting-started",
				"title": "Getting started",
				"trigger": "first-visit",
				"minAppVersion": "0.1.27",
				"steps": [
					{ "id": "welcome", "sinceVersion": "0.1.27", "placement": "center", "title": "Welcome to LARPing", "body": "Let's take a quick spin through your world — we'll create a character and an event together so you can see how the pieces fit. You'll add each record yourself.", "target": { "kind": "page", "ref": "Dashboard" }, "advanceOn": { "type": "manual" } },
					{ "id": "go-characters", "sinceVersion": "0.1.27", "placement": "right", "body": "Characters are the heart of your world. Open Characters from the menu to get started.", "task": "Click Characters in the menu", "target": { "kind": "nav-item", "ref": "Characters" }, "advanceOn": { "type": "route-match", "route": "Characters" } },
					{ "id": "create-character", "sinceVersion": "0.1.27", "placement": "bottom", "allowManualNext": true, "body": "Add your first character — give them a name and a type, and save. You can flesh out abilities, skills and items later.", "task": "Click New and save a character", "target": { "kind": "element", "ref": "index-add" }, "advanceOn": { "type": "object-created", "register": "larpingapp", "schema": "character", "capture": { "characterId": ":id" } } },
					{ "id": "go-events", "sinceVersion": "0.1.27", "placement": "right", "body": "Events are the game sessions where your world comes alive. Open Events from the menu.", "task": "Click Events in the menu", "target": { "kind": "nav-item", "ref": "Events" }, "advanceOn": { "type": "route-match", "route": "Events" } },
					{ "id": "create-event", "sinceVersion": "0.1.27", "placement": "bottom", "allowManualNext": true, "body": "Create your first event — name it and set a start date, then save. Your characters can join it from here.", "task": "Click New and save an event", "target": { "kind": "element", "ref": "index-add" }, "advanceOn": { "type": "object-created", "register": "larpingapp", "schema": "larping_event", "capture": { "eventId": ":id" } } },
					{ "id": "done", "sinceVersion": "0.1.27", "placement": "center", "title": "You're all set", "body": "Nicely done — your world has its first character and event. Head back to the Dashboard to watch it grow, and reopen this tour anytime from the … menu.", "target": { "kind": "page", "ref": "Dashboard" }, "advanceOn": { "type": "manual" } }
				]
			}
		]
	},
	"menu": [
		{ "id": "Dashboard", "label": "Dashboard", "icon": "ViewDashboard", "route": "Dashboard", "order": 10 },
		{
			"id": "CharactersGroup",
			"label": "Characters",
			"icon": "BriefcaseAccountOutline",
			"order": 20,
			"children": [
				{ "id": "Characters", "label": "Characters", "icon": "BriefcaseAccountOutline", "route": "Characters", "order": 20 },
				{ "id": "Players",    "label": "Players",    "icon": "AccountGroupOutline",     "route": "Players",    "order": 30 }
			]
		},
		{
			"id": "MechanicsGroup",
			"label": "Mechanics",
			"icon": "FlashOutline",
			"order": 40,
			"children": [
				{ "id": "Abilities",   "label": "Abilities",   "icon": "FlashOutline",        "route": "Abilities",   "order": 40 },
				{ "id": "Skills",      "label": "Skills",      "icon": "StarOutline",          "route": "Skills",      "order": 50 },
				{ "id": "Conditions",  "label": "Conditions",  "icon": "EmoticonSickOutline",  "route": "Conditions",  "order": 70 },
				{ "id": "Effects",     "label": "Effects",     "icon": "MagicStaff",           "route": "Effects",     "order": 80 }
			]
		},
		{
			"id": "WorldGroup",
			"label": "World",
			"icon": "Sword",
			"order": 60,
			"children": [
				{ "id": "Items",  "label": "Items",  "icon": "Sword",              "route": "Items",  "order": 60 },
				{ "id": "Events", "label": "Events", "icon": "CalendarMonthOutline","route": "Events", "order": 90 },
				{ "id": "XpAwards", "label": "XP Awards", "icon": "StarPlusOutline", "route": "XpAwards", "order": 95 }
			]
		},
		{ "id": "Settings",          "label": "Settings (Worlds)","icon": "Globe",       "route": "Settings",     "order": 25 },
		{ "id": "GameSettings",      "label": "Game Settings",    "icon": "Cog",         "route": "GameSettings", "order": 100, "section": "settings" },
		{ "id": "Documentation",     "label": "Documentation",    "icon": "icon-info",   "href": "https://larpingapp.conduction.nl", "section": "footer", "order": 90 },
		{ "id": "FeaturesRoadmapMenu","label": "Features & roadmap","icon": "icon-toggle","route": "FeaturesRoadmap", "section": "footer", "order": 91 }
	],
	"pages": [
		{
			"id": "Dashboard",
			"route": "/",
			"type": "dashboard",
			"title": "Dashboard",
			"actionsComponent": "DashboardActions",
			"config": {
				"widgets": [
					{ "id": "kpi-characters", "title": "Characters",       "type": "stat", "content": { "label": "Characters", "route": { "name": "Characters" }, "icon": "AccountGroup", "valueColor": "#0082c9", "format": { "style": "number" }, "source": { "register": "larpingapp", "schema": "character", "metric": "count", "filter": {} } } },
					{ "id": "kpi-events",     "title": "Events",           "type": "stat", "content": { "label": "Events", "route": { "name": "Events" }, "icon": "Calendar", "valueColor": "#0082c9", "format": { "style": "number" }, "source": { "register": "larpingapp", "schema": "larping_event", "metric": "count", "filter": {} } } },
					{ "id": "kpi-items",      "title": "Items",            "type": "stat", "content": { "label": "Items", "route": { "name": "Items" }, "icon": "Star", "valueColor": "#0082c9", "format": { "style": "number" }, "source": { "register": "larpingapp", "schema": "larping_item", "metric": "count", "filter": {} } } },
					{ "id": "kpi-players",    "title": "Players",          "type": "stat", "content": { "label": "Players", "route": { "name": "Players" }, "icon": "Account", "valueColor": "#0082c9", "format": { "style": "number" }, "source": { "register": "larpingapp", "schema": "player", "metric": "count", "filter": {} } } },
					{ "id": "recent-characters", "title": "Recent characters", "type": "object-list", "content": { "register": "larpingapp", "schema": "character", "filter": {}, "sort": { "field": "created", "dir": "desc" }, "limit": 6, "rowRoute": "CharacterDetail", "columns": [{ "key": "name", "label": "Name" }, { "key": "type", "label": "Type" }] } },
					{ "id": "recent-events",     "title": "Recent events",     "type": "object-list", "content": { "register": "larpingapp", "schema": "larping_event", "filter": {}, "sort": { "field": "startDate", "dir": "desc" }, "limit": 6, "rowRoute": "EventDetail", "columns": [{ "key": "name", "label": "Event" }, { "key": "startDate", "label": "Starts" }] } },
					{ "id": "skill-usage",    "title": "Skill usage by characters", "type": "custom" }
				],
				"layout": [
					{ "id": 1, "widgetId": "kpi-characters", "gridX": 0, "gridY": 0, "gridWidth": 3, "gridHeight": 2, "showTitle": false },
					{ "id": 2, "widgetId": "kpi-events",     "gridX": 3, "gridY": 0, "gridWidth": 3, "gridHeight": 2, "showTitle": false },
					{ "id": 3, "widgetId": "kpi-items",      "gridX": 6, "gridY": 0, "gridWidth": 3, "gridHeight": 2, "showTitle": false },
					{ "id": 4, "widgetId": "kpi-players",    "gridX": 9, "gridY": 0, "gridWidth": 3, "gridHeight": 2, "showTitle": false },
					{ "id": 5, "widgetId": "recent-characters", "gridX": 0, "gridY": 2, "gridWidth": 6, "gridHeight": 4 },
					{ "id": 6, "widgetId": "recent-events",     "gridX": 6, "gridY": 2, "gridWidth": 6, "gridHeight": 4 },
					{ "id": 7, "widgetId": "skill-usage",    "gridX": 0, "gridY": 6, "gridWidth": 12, "gridHeight": 5 }
				],
				"documentationUrl": "https://larpingapp.conduction.nl"
			},
			"slots": {
				"widget-skill-usage":      "DashboardSkillUsage"
			}
		},
		{
			"id": "Characters",
			"route": "/characters",
			"type": "index",
			"title": "Characters",
			"config": { "register": "larpingapp", "schema": "character", "documentationUrl": "https://larpingapp.conduction.nl" }
		},
		{
			"id": "CharacterDetail",
			"route": "/characters/:id",
			"type": "detail",
			"title": "Character",
			"config": {
				"register": "larpingapp",
				"schema": "character",
				"documentationUrl": "https://larpingapp.conduction.nl",
				"_note": "Character sheet — the richest record in the app. The body leads with the character's identity/stats (data, 8-wide, including background/private notes/character card fields — the schema has no separate GM-notes archetype so they stay in the main sheet) plus a live XP/gold stat rail and approval state; the right rail lists the linked mechanics (abilities via effects, skills, items, conditions) and event participation as related groups so a GM can see the whole build at a glance. The character portrait/sheet lives in the photos leaf (schema declares linkedType 'photos') as a body integration widget. XP awards granted to this character are shown as an object-list (xpAward.character FK = @objectId). No email/calendar on the body: the character schema declares only 'photos'. Sidebar is audit-history only — the photos leaf already lives in the body, so it is not duplicated as a sidebar tab.",
				"widgets": [
					{ "id": "char-data", "type": "data", "title": "Character sheet", "content": { "columns": 2 } },
					{ "id": "char-xp", "type": "stat", "title": "XP awarded", "content": { "label": "Total XP awarded", "icon": "StarPlus", "format": { "style": "number" }, "source": { "register": "larpingapp", "schema": "xpAward", "metric": "sum", "field": "amount", "filter": { "character": "@objectId" } } } },
					{ "id": "char-gold", "type": "stat", "title": "Gold", "content": { "label": "Gold pieces", "icon": "CircleMultiple", "format": { "style": "number" }, "source": { "register": "larpingapp", "schema": "character", "metric": "sum", "field": "gold", "filter": { "id": "@objectId" } } } },
					{ "id": "char-related", "type": "related", "title": "Build & world", "content": { "groups": [ { "key": "skills", "label": "Skills" }, { "key": "items", "label": "Items" }, { "key": "conditions", "label": "Conditions" }, { "key": "events", "label": "Events" } ] } },
					{ "id": "char-xpawards", "type": "object-list", "title": "XP award history", "content": { "register": "larpingapp", "schema": "xpAward", "filter": { "character": "@objectId" }, "sort": { "field": "awardedAt", "dir": "desc" }, "columns": [ { "key": "event", "label": "Event" }, { "key": "amount", "label": "XP" }, { "key": "reason", "label": "Reason" }, { "key": "awardedAt", "label": "Awarded" } ], "limit": 50 } },
					{ "id": "char-photos", "type": "integration", "integrationId": "photos", "title": "Portrait & sheet" }
				],
				"layout": [
					{ "id": "1", "widgetId": "char-data", "gridX": 0, "gridY": 0, "gridWidth": 8, "gridHeight": 5 },
					{ "id": "2", "widgetId": "char-xp", "gridX": 8, "gridY": 0, "gridWidth": 4, "gridHeight": 2, "showTitle": false },
					{ "id": "3", "widgetId": "char-gold", "gridX": 8, "gridY": 2, "gridWidth": 4, "gridHeight": 2, "showTitle": false },
					{ "id": "4", "widgetId": "char-related", "gridX": 8, "gridY": 4, "gridWidth": 4, "gridHeight": 5 },
					{ "id": "5", "widgetId": "char-xpawards", "gridX": 0, "gridY": 5, "gridWidth": 8, "gridHeight": 4 },
					{ "id": "6", "widgetId": "char-photos", "gridX": 0, "gridY": 9, "gridWidth": 12, "gridHeight": 4 }
				],
				"sidebar": {
					"enabled": true,
					"showMetadata": true,
					"tabs": [
						{ "id": "audit", "label": "History", "icon": "History", "widgets": [ { "type": "audit" } ] }
					]
				}
			}
		},
		{
			"id": "Players",
			"route": "/players",
			"type": "index",
			"title": "Players",
			"config": { "register": "larpingapp", "schema": "player", "documentationUrl": "https://larpingapp.conduction.nl" }
		},
		{
			"id": "PlayerDetail",
			"route": "/players/:id",
			"type": "detail",
			"title": "Player",
			"config": {
				"register": "larpingapp",
				"schema": "player",
				"documentationUrl": "https://larpingapp.conduction.nl",
				"_note": "Player = the real-world person behind the characters (person archetype). The player schema is deliberately thin (name + notes) and its only declared linkedType is 'contacts', so the body is person-first: identity/notes (data, 7-wide) beside the linked Nextcloud contact card (contacts integration, 5-wide) for phone/email/address. Related shows any objects that reference this player. No email/calendar/talk widgets on the body — the schema declares only 'contacts', and characters attach to a player by owner UID / OC name (string), not a hard FK, so there is no reliable child object-list. Sidebar is audit-history only — the contact card already lives in the body, so it is not duplicated as a sidebar tab.",
				"widgets": [
					{ "id": "player-data", "type": "data", "title": "Player", "content": { "columns": 1 } },
					{ "id": "player-contacts", "type": "integration", "integrationId": "contacts", "title": "Contact card" },
					{ "id": "player-related", "type": "related", "title": "Related" }
				],
				"layout": [
					{ "id": "1", "widgetId": "player-data", "gridX": 0, "gridY": 0, "gridWidth": 7, "gridHeight": 4 },
					{ "id": "2", "widgetId": "player-contacts", "gridX": 7, "gridY": 0, "gridWidth": 5, "gridHeight": 4 },
					{ "id": "3", "widgetId": "player-related", "gridX": 0, "gridY": 4, "gridWidth": 12, "gridHeight": 3 }
				],
				"sidebar": {
					"enabled": true,
					"showMetadata": true,
					"tabs": [
						{ "id": "audit", "label": "History", "icon": "History", "widgets": [ { "type": "audit" } ] }
					]
				}
			}
		},
		{
			"id": "Abilities",
			"route": "/abilities",
			"type": "index",
			"title": "Abilities",
			"config": { "register": "larpingapp", "schema": "ability", "documentationUrl": "https://larpingapp.conduction.nl" }
		},
		{
			"id": "AbilityDetail",
			"route": "/abilities/:id",
			"type": "detail",
			"title": "Ability",
			"config": {
				"register": "larpingapp",
				"schema": "ability",
				"documentationUrl": "https://larpingapp.conduction.nl",
				"_note": "Ability = a numeric stat (XP, Mana, Health, Armor) that characters track (rules-object archetype). The body is definition-first: the stat's name/description/base value (data, 8-wide) plus a large base-value stat card, then the reverse index of what touches this stat — the effects that modify it (effect.abilities FK = @objectId) and the skills that gate on it (skill.requiredStats contains @objectId). This is a pure rules object: no comms, no files, no attachments — a GM reads it to understand how a stat is wired into the ruleset.",
				"widgets": [
					{ "id": "ability-data", "type": "data", "title": "Ability", "content": { "columns": 2 } },
					{ "id": "ability-base", "type": "stat", "title": "Base value", "content": { "label": "Base value", "icon": "ShieldSword", "format": { "style": "number" }, "source": { "register": "larpingapp", "schema": "ability", "metric": "sum", "field": "base", "filter": { "id": "@objectId" } } } },
					{ "id": "ability-effects", "type": "object-list", "title": "Effects modifying this ability", "content": { "register": "larpingapp", "schema": "effect", "filter": { "abilities": "@objectId" }, "columns": [ { "key": "name", "label": "Effect" }, { "key": "modifier", "label": "Modifier" }, { "key": "modification", "label": "Direction" }, { "key": "cumulative", "label": "Stacks" } ], "limit": 50 } },
					{ "id": "ability-skills", "type": "object-list", "title": "Skills requiring this stat", "content": { "register": "larpingapp", "schema": "skill", "filter": { "requiredStats": "@objectId" }, "columns": [ { "key": "name", "label": "Skill" }, { "key": "requiredScore", "label": "Min score" } ], "limit": 50 } },
					{ "id": "ability-related", "type": "related", "title": "Related" }
				],
				"layout": [
					{ "id": "1", "widgetId": "ability-data", "gridX": 0, "gridY": 0, "gridWidth": 8, "gridHeight": 3 },
					{ "id": "2", "widgetId": "ability-base", "gridX": 8, "gridY": 0, "gridWidth": 4, "gridHeight": 3, "showTitle": false },
					{ "id": "3", "widgetId": "ability-effects", "gridX": 0, "gridY": 3, "gridWidth": 6, "gridHeight": 4 },
					{ "id": "4", "widgetId": "ability-skills", "gridX": 6, "gridY": 3, "gridWidth": 6, "gridHeight": 4 },
					{ "id": "5", "widgetId": "ability-related", "gridX": 0, "gridY": 7, "gridWidth": 12, "gridHeight": 3 }
				],
				"sidebar": {
					"enabled": true,
					"showMetadata": true,
					"tabs": [
						{ "id": "audit", "label": "History", "icon": "History", "widgets": [ { "type": "audit" } ] }
					]
				}
			}
		},
		{
			"id": "Skills",
			"route": "/skills",
			"type": "index",
			"title": "Skills",
			"config": { "register": "larpingapp", "schema": "skill", "documentationUrl": "https://larpingapp.conduction.nl" }
		},
		{
			"id": "SkillDetail",
			"route": "/skills/:id",
			"type": "detail",
			"title": "Skill",
			"config": {
				"register": "larpingapp",
				"schema": "skill",
				"documentationUrl": "https://larpingapp.conduction.nl",
				"_note": "Skill = a learnable, XP-purchased ability with prerequisites (rules-object archetype, prerequisite-heavy). The body leads with the skill's flavour + mechanical effect (data, 8-wide) beside a related rail that surfaces the four prerequisite groups the schema carries (required skills, required stats, required conditions, required effects) plus the effects it grants — the whole dependency tree in one place. Below, an object-list of characters who have learned this skill (character.skills contains @objectId) lets a GM see adoption. Pure rules object: no comms, no files.",
				"widgets": [
					{ "id": "skill-data", "type": "data", "title": "Skill", "content": { "columns": 2 } },
					{ "id": "skill-prereqs", "type": "related", "title": "Effects & prerequisites", "content": { "groups": [ { "key": "effects", "label": "Grants effects" }, { "key": "requiredSkills", "label": "Requires skills" }, { "key": "requiredStats", "label": "Requires stats" }, { "key": "requiredConditions", "label": "Requires conditions" }, { "key": "requiredEffects", "label": "Requires effects" } ] } },
					{ "id": "skill-characters", "type": "object-list", "title": "Characters with this skill", "content": { "register": "larpingapp", "schema": "character", "filter": { "skills": "@objectId" }, "columns": [ { "key": "name", "label": "Character" }, { "key": "type", "label": "Type" }, { "key": "approved", "label": "Approved" } ], "limit": 50 } }
				],
				"layout": [
					{ "id": "1", "widgetId": "skill-data", "gridX": 0, "gridY": 0, "gridWidth": 8, "gridHeight": 5 },
					{ "id": "2", "widgetId": "skill-prereqs", "gridX": 8, "gridY": 0, "gridWidth": 4, "gridHeight": 5 },
					{ "id": "3", "widgetId": "skill-characters", "gridX": 0, "gridY": 5, "gridWidth": 12, "gridHeight": 4 }
				],
				"sidebar": {
					"enabled": true,
					"showMetadata": true,
					"tabs": [
						{ "id": "audit", "label": "History", "icon": "History", "widgets": [ { "type": "audit" } ] }
					]
				}
			}
		},
		{
			"id": "Items",
			"route": "/items",
			"type": "index",
			"title": "Items",
			"config": { "register": "larpingapp", "schema": "larping_item", "documentationUrl": "https://larpingapp.conduction.nl" }
		},
		{
			"id": "ItemDetail",
			"route": "/items/:id",
			"type": "detail",
			"title": "Item",
			"config": {
				"register": "larpingapp",
				"schema": "larping_item",
				"documentationUrl": "https://larpingapp.conduction.nl",
				"_note": "Item = a magical/special object that grants effects to its holder (rules-object archetype, ownership-tracked). The body leads with the item's player-visible story description + GM mechanical effect (data, 8-wide) beside the effects it confers (related), then an object-list of the characters currently holding it (item.characters contains @objectId / character.items) — critical for unique artifacts where only one holder may exist. Files are on the body because props and physrep photos/handouts are commonly attached to items. No email/calendar: the item schema declares no comms linkedTypes.",
				"widgets": [
					{ "id": "item-data", "type": "data", "title": "Item", "content": { "columns": 2 } },
					{ "id": "item-effects", "type": "related", "title": "Effects", "content": { "groups": [ { "key": "effects", "label": "Grants effects" } ] } },
					{ "id": "item-holders", "type": "object-list", "title": "Held by", "content": { "register": "larpingapp", "schema": "character", "filter": { "items": "@objectId" }, "columns": [ { "key": "name", "label": "Character" }, { "key": "type", "label": "Type" } ], "limit": 50 } },
					{ "id": "item-files", "type": "integration", "integrationId": "files", "title": "Props & handouts" }
				],
				"layout": [
					{ "id": "1", "widgetId": "item-data", "gridX": 0, "gridY": 0, "gridWidth": 8, "gridHeight": 4 },
					{ "id": "2", "widgetId": "item-effects", "gridX": 8, "gridY": 0, "gridWidth": 4, "gridHeight": 4 },
					{ "id": "3", "widgetId": "item-holders", "gridX": 0, "gridY": 4, "gridWidth": 6, "gridHeight": 4 },
					{ "id": "4", "widgetId": "item-files", "gridX": 6, "gridY": 4, "gridWidth": 6, "gridHeight": 4 }
				],
				"sidebar": {
					"enabled": true,
					"showMetadata": true,
					"tabs": [
						{ "id": "audit", "label": "History", "icon": "History", "widgets": [ { "type": "audit" } ] }
					]
				}
			}
		},
		{
			"id": "Conditions",
			"route": "/conditions",
